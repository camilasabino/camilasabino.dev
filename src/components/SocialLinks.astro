---
interface Props {
  class?: string;
  compact?: boolean;
}

const { class: className = '', compact = false } = Astro.props;
---

<div class:list={['social-links', compact && 'social-links--compact', className]}>
  <a
    class="social-link"
    href="mailto:contacto@camilasabino.dev"
    aria-label="Email"
    title="contacto@camilasabino.dev"
  >
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M4 6.75A1.75 1.75 0 0 1 5.75 5h12.5A1.75 1.75 0 0 1 20 6.75v10.5A1.75 1.75 0 0 1 18.25 19H5.75A1.75 1.75 0 0 1 4 17.25V6.75Z"
        stroke="currentColor"
        stroke-width="1.7"></path>
      <path
        d="m5 7 7 5.5L19 7"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    {!compact && <span>Mail</span>}
  </a>
  <a
    class="social-link"
    href="https://www.linkedin.com/in/camilasabino/"
    rel="noopener noreferrer"
    target="_blank"
    aria-label="LinkedIn"
    title="LinkedIn"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M6.94 8.5H4.1V19h2.84V8.5ZM5.52 4A1.66 1.66 0 1 0 5.5 7.3 1.66 1.66 0 0 0 5.52 4ZM20 19h-2.83v-5.4c0-1.54-.55-2.6-1.92-2.6a2.07 2.07 0 0 0-1.94 1.4 2.7 2.7 0 0 0-.12.93V19H10.4s.04-9.2 0-10.15h2.83v1.44c.38-.58 1.05-1.4 2.56-1.4 1.87 0 3.27 1.22 3.27 3.85V19Z"
      ></path>
    </svg>
    {!compact && <span>LinkedIn</span>}
  </a>
  <a
    class="social-link"
    href="https://github.com/camilasabino"
    rel="noopener noreferrer"
    target="_blank"
    aria-label="GitHub"
    title="GitHub"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        fill-rule="evenodd"
        d="M12 2.25c-5.37 0-9.75 4.38-9.75 9.75 0 4.3 2.79 7.95 6.66 9.24.49.1.66-.21.66-.47v-1.66c-2.71.59-3.28-1.15-3.28-1.15-.44-1.12-1.08-1.42-1.08-1.42-.88-.6.07-.59.07-.59.98.07 1.5 1 1.5 1 .87 1.49 2.28 1.06 2.84.81.09-.63.34-1.06.62-1.3-2.16-.25-4.44-1.08-4.44-4.82 0-1.07.38-1.94 1-2.62-.1-.25-.43-1.24.1-2.58 0 0 .82-.26 2.68 1a9.3 9.3 0 0 1 4.88 0c1.86-1.26 2.68-1 2.68-1 .53 1.34.2 2.33.1 2.58.62.68 1 1.55 1 2.62 0 3.75-2.28 4.57-4.45 4.81.35.3.66.9.66 1.82v2.7c0 .26.18.57.67.47A9.76 9.76 0 0 0 21.75 12c0-5.37-4.38-9.75-9.75-9.75Z"
        clip-rule="evenodd"></path>
    </svg>
    {!compact && <span>GitHub</span>}
  </a>
</div>
