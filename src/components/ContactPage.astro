---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocalizedPath, type Lang } from '../i18n';
import { contact } from '../i18n/content';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const copy = contact[lang];
const path = getLocalizedPath('contact', lang);
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
const contactEmail = 'contacto@camilasabino.dev';
---

<BaseLayout title={copy.title} description={copy.description} path={path} lang={lang}>
  <section class="contact">
    <header class="contact-intro">
      <h1>{copy.heading}</h1>
      <p class="lede">{copy.lede}</p>
    </header>

    <div class="contact-layout">
      <form
        class="contact-form"
        data-contact-form
        data-msg-not-configured={copy.statusNotConfigured}
        data-msg-sending={copy.statusSending}
        data-msg-ok={copy.statusOk}
        data-msg-fail={copy.statusFail}
        data-msg-error={copy.statusError}
        novalidate
      >
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value={copy.subject} />
        <input type="hidden" name="from_name" value="camilasabino.dev" />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />

        <label>
          <span>{copy.name}</span>
          <input type="text" name="name" required maxlength="120" autocomplete="name" />
        </label>

        <label>
          <span>{copy.email}</span>
          <input type="email" name="email" required maxlength="200" autocomplete="email" />
        </label>

        <label>
          <span>{copy.message}</span>
          <textarea name="message" required rows="6" maxlength="4000"></textarea>
        </label>

        <div class="contact-actions">
          <button class="btn btn-primary" type="submit" data-submit>
            {copy.submit}
          </button>
          <p class="form-status" data-status role="status" aria-live="polite"></p>
        </div>

        {!accessKey && <p class="form-hint">{copy.missingKey}</p>}
      </form>

      <aside class="contact-aside">
        <h2>{copy.asideTitle}</h2>
        <p>{copy.asideBody}</p>
        <a
          class="btn btn-ghost"
          href={`mailto:${contactEmail}?subject=${encodeURIComponent(copy.mailtoSubject)}`}
        >
          {copy.openMail}
        </a>
        <p class="contact-email">
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const accessKey = (
      form.querySelector('input[name="access_key"]') as HTMLInputElement | null
    )?.value;
    const messages = {
      notConfigured: form.dataset.msgNotConfigured ?? '',
      sending: form.dataset.msgSending ?? '',
      ok: form.dataset.msgOk ?? '',
      fail: form.dataset.msgFail ?? '',
      error: form.dataset.msgError ?? '',
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status || !submit) return;

      if (!accessKey) {
        status.dataset.state = 'error';
        status.textContent = messages.notConfigured;
        return;
      }

      if (!form.reportValidity()) return;

      submit.disabled = true;
      status.dataset.state = 'pending';
      status.textContent = messages.sending;

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = (await response.json()) as { success?: boolean; message?: string };

        if (!response.ok || !result.success) {
          throw new Error(result.message || messages.fail);
        }

        status.dataset.state = 'ok';
        status.textContent = messages.ok;
        form.reset();
      } catch (error) {
        status.dataset.state = 'error';
        status.textContent =
          error instanceof Error ? error.message : messages.error;
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
