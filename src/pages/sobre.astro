---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sobre mí — Camila Sabino"
  description="Software engineer en Buenos Aires. E-commerce, payments, APIs y sistemas distribuidos."
  path="/sobre"
>
  <header class="about-top">
    <div>
      <h1>Ingeniera de software con mirada de producto.</h1>
      <p class="lede">
        Seis años en Tiendanube construyendo pagos, promociones y seguridad a escala LatAm. Me
        importa que el sistema sea simple, robusto y fácil de evolucionar.
      </p>
    </div>
    <div class="about-photo-wrap">
      <img
        src="/images/camila.jpg"
        alt="Camila Sabino"
        width="900"
        height="1125"
      />
    </div>
  </header>

  <div class="band">
    <div class="band-inner">
      <p>CV en PDF · LinkedIn · código en GitHub</p>
      <div class="cta-row">
        <a
          class="btn btn-primary"
          href="/cv/Camila-Sabino-CV.pdf"
          download="Camila-Sabino-CV.pdf">Descargar CV</a
        >
        <a
          class="btn btn-ghost"
          href="https://www.linkedin.com/in/camilasabino/"
          rel="noopener noreferrer"
          target="_blank">LinkedIn</a
        >
        <a
          class="btn btn-ghost"
          href="https://github.com/camilasabino"
          rel="noopener noreferrer"
          target="_blank">GitHub</a
        >
      </div>
    </div>
  </div>

  <section class="timeline">
    <h2>Experiencia</h2>

    <article class="job">
      <p class="job-when">2019 – 2025</p>
      <div>
        <h3>Software Engineer</h3>
        <p class="role-place">Tiendanube · Buenos Aires</p>
        <p>
          Dominios críticos de la plataforma de e-commerce: Payments, Promotions y Account &amp;
          Security, en una arquitectura distribuida de alto volumen.
        </p>
        <ul>
          <li>
            Payments API con +30 proveedores externos y evolución hacia integraciones desacopladas.
          </li>
          <li>
            Microservicios en Scala (Akka, Play) y Java (Spring Boot); Activity Logs con Kafka y
            Elasticsearch.
          </li>
          <li>2FA, sesiones y funcionalidades cross-stack según el producto.</li>
        </ul>
      </div>
    </article>

    <article class="job">
      <p class="job-when">2018 – 2019</p>
      <div>
        <h3>Full Stack Developer</h3>
        <p class="role-place">UTN — Facultad Regional Buenos Aires</p>
        <p>
          Sistema de Gestión Académica para docentes, alumnos y administración. Migración legacy a
          SIU Guaraní y desarrollo en Laravel, Twig y JavaScript.
        </p>
      </div>
    </article>
  </section>

  <section class="split-meta">
    <div>
      <h2>Educación</h2>
      <ul class="plain-list">
        <li>
          <strong>Ingeniería en Sistemas de Información</strong>
          <span>UTN · 2014 – 2018</span>
        </li>
        <li>
          <strong>Bachiller en Economía y Administración</strong>
          <span>EES N° 3 José Manuel Estrada · 2008 – 2013</span>
        </li>
      </ul>
    </div>
    <div>
      <h2>Idiomas</h2>
      <ul class="plain-list">
        <li>
          <strong>Español</strong>
          <span>Nativo</span>
        </li>
        <li>
          <strong>Inglés</strong>
          <span>Avanzado</span>
        </li>
        <li>
          <strong>Portugués</strong>
          <span>Intermedio</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="split-meta">
    <div>
      <h2>Cómo trabajo</h2>
      <ul class="stack">
        <li>Diseño de sistemas</li>
        <li>Arquitectura distribuida</li>
        <li>DDD / APIs</li>
        <li>Producto</li>
        <li>Calidad</li>
        <li>Performance</li>
      </ul>
    </div>
    <div>
      <h2>Stack</h2>
      <ul class="stack">
        <li>Java / Spring</li>
        <li>Scala</li>
        <li>Node.js</li>
        <li>TypeScript / React</li>
        <li>PHP / Laravel</li>
        <li>MySQL · Mongo · Redis</li>
        <li>Kafka · Elasticsearch</li>
        <li>AWS · Docker</li>
      </ul>
    </div>
  </section>
</BaseLayout>
