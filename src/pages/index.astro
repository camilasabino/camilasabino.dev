---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Camila Sabino" path="/" home>
  <section class="landing">
    <div class="landing-panel">
      <p class="landing-meta">Software engineer · Buenos Aires</p>
      <h1>Camila Sabino</h1>
      <p class="lede">
        Diseño y construyo sistemas de producto que aguantan escala: pagos, APIs y arquitectura
        distribuida — de punta a punta.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/#proyectos">Ver trabajo</a>
        <a class="btn btn-ghost" href="/sobre">Sobre mí</a>
      </div>
    </div>

    <a class="landing-stage" href="/projects/blendify" aria-label="Ver Blendify">
      <img
        src="/projects/blendify/landing.webp"
        alt="Captura de Blendify"
        width="1600"
        height="1000"
        fetchpriority="high"
      />
      <span class="landing-stage-caption">
        <span>Proyecto destacado</span>
        <strong>Blendify →</strong>
      </span>
    </a>
  </section>

  <div class="shell">
    <section class="section" id="proyectos">
      <div class="section-head">
        <h2>Trabajo reciente</h2>
        <p>Producto y full stack</p>
      </div>

      <a class="project-feature" href="/projects/blendify">
        <div class="project-feature-media">
          <img
            src="/projects/blendify/mix-artists.webp"
            alt="Artist Mix en Blendify"
            width="1280"
            height="800"
          />
        </div>
        <div class="project-feature-body">
          <span class="label">Producto · Full stack</span>
          <h3 class="project-feature-title">Blendify</h3>
          <p>
            Workspace para armar mixes de Spotify desde artistas, géneros o una semilla — con
            descubrimiento, biblioteca y recetas tipadas.
          </p>
          <span class="more">Abrir caso →</span>
        </div>
      </a>
    </section>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Camila Sabino · Buenos Aires</span>
      <span>
        <a href="mailto:contacto@camilasabino.dev">contacto@camilasabino.dev</a>
        ·
        <a
          href="https://www.linkedin.com/in/camilasabino/"
          rel="noopener noreferrer"
          target="_blank">LinkedIn</a
        >
        ·
        <a href="https://github.com/camilasabino" rel="noopener noreferrer" target="_blank"
          >GitHub</a
        >
      </span>
    </footer>
  </div>
</BaseLayout>
