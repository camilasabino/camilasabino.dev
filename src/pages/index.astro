---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Camila Sabino" path="/" home>
  <section class="landing">
    <div class="landing-inner">
      <div class="landing-intro">
        <h1>Camila Sabino</h1>
        <div class="landing-portrait">
          <img
            src="/images/camila.jpg"
            alt="Camila Sabino"
            width="216"
            height="216"
            fetchpriority="high"
          />
        </div>
      </div>
      <p class="lede">
        Construyo software de producto que escala: pagos, APIs y sistemas distribuidos — de punta a
        punta.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/#proyectos">Ver trabajo</a>
        <a class="btn btn-ghost" href="/sobre">Conocerme</a>
      </div>
    </div>
  </section>

  <div class="shell">
    <section class="section" id="proyectos">
      <div class="section-head">
        <h2>Trabajo reciente</h2>
        <p>Proyectos y producto</p>
      </div>

      <a class="project-feature" href="/projects/blendify">
        <div class="project-feature-media">
          <img
            src="/projects/blendify/landing.webp"
            alt="Vista de Blendify"
            width="1280"
            height="800"
          />
        </div>
        <div class="project-feature-body">
          <span class="label">Producto · Full stack</span>
          <h3 class="project-feature-title">Blendify</h3>
          <p>
            Un workspace para armar mixes de Spotify desde artistas, géneros o una semilla — con
            descubrimiento, biblioteca y recetas tipadas.
          </p>
          <span class="more">Ver proyecto →</span>
        </div>
      </a>
    </section>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Camila Sabino · Buenos Aires</span>
      <span>
        <a href="mailto:contacto@camilasabino.dev">contacto@camilasabino.dev</a>
        ·
        <a
          href="https://www.linkedin.com/in/camilasabino/"
          rel="noopener noreferrer"
          target="_blank">LinkedIn</a
        >
        ·
        <a href="https://github.com/camilasabino" rel="noopener noreferrer" target="_blank"
          >GitHub</a
        >
      </span>
    </footer>
  </div>
</BaseLayout>
