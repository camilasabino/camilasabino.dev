---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  path?: string;
}

const {
  title,
  description = 'Portfolio de Camila Sabino — software, producto y proyectos como Blendify.',
  path = '/',
} = Astro.props;

const site = 'https://camilasabino.dev';
const canonical = new URL(path, site).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es" />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href="/">Camila Sabino</a>
        <nav class="nav" aria-label="Principal">
          <a href="/#proyectos" aria-current={path.startsWith('/projects') ? 'page' : undefined}>
            Proyectos
          </a>
          <a href="https://github.com/camilasabino" rel="noopener noreferrer" target="_blank">
            GitHub
          </a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span>© {new Date().getFullYear()} Camila Sabino</span>
        <span>
          <a href="mailto:hola@camilasabino.dev">hola@camilasabino.dev</a>
          ·
          <a href="https://github.com/camilasabino" rel="noopener noreferrer" target="_blank"
            >GitHub</a
          >
        </span>
      </footer>
    </div>
  </body>
</html>
