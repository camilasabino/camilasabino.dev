---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  path?: string;
  home?: boolean;
}

const {
  title,
  description = 'Camila Sabino — software engineer en Buenos Aires. Sistemas de producto, APIs y proyectos como Blendify.',
  path = '/',
  home = false,
} = Astro.props;

const site = 'https://camilasabino.dev';
const canonical = new URL(path, site).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es" />
    <meta property="og:image" content={`${site}/images/camila.jpg`} />
    <title>{title}</title>
  </head>
  <body class={home ? 'page-home' : undefined}>
    <div class={home ? undefined : 'shell'}>
      <header class:list={['site-header', home && 'shell']}>
        <a class="brand" href="/">Camila Sabino</a>
        <nav class="nav" aria-label="Principal">
          <a href="/#proyectos" aria-current={path.startsWith('/projects') ? 'page' : undefined}
            >Trabajo</a
          >
          <a href="/sobre" aria-current={path === '/sobre' ? 'page' : undefined}>Sobre</a>
          <a href="mailto:contacto@camilasabino.dev">Contacto</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      {
        !home && (
          <footer class="site-footer">
            <span>© {new Date().getFullYear()} Camila Sabino</span>
            <span>
              <a href="mailto:contacto@camilasabino.dev">contacto@camilasabino.dev</a>
              ·
              <a
                href="https://www.linkedin.com/in/camilasabino/"
                rel="noopener noreferrer"
                target="_blank"
              >
                LinkedIn
              </a>
              ·
              <a
                href="https://github.com/camilasabino"
                rel="noopener noreferrer"
                target="_blank"
              >
                GitHub
              </a>
            </span>
          </footer>
        )
      }
    </div>
  </body>
</html>
